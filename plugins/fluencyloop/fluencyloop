#!/usr/bin/env bash
# fluencyloop — the FluencyLoop CLI dispatcher.
#
# Deterministic commands run directly; the interactive stages (constitution, feature,
# review, backfill) are driven by the skills supplied by the installed Claude Code or Codex
# plugin.
# This dispatcher scaffolds a project and exposes the plumbing so the skills — or you — can
# call it.
#
# Usage:
#   fluencyloop init                       scaffold .fluencyloop/ state + docs/fluencyloop/
#   fluencyloop plan "<intent>"            declare a plan (architecture + roadmap for a big chunk)
#   fluencyloop feature "<intent>"         declare a feature (branch + store record)
#   fluencyloop session "<intent>"         open a session in the active feature
#   fluencyloop decision --where … --why … append a formatted decision block to the session
#   fluencyloop knowledge --component …    batch session knowledge records
#   fluencyloop concept --name …           capture an architectural concept or relation
#   fluencyloop requirement --gap …        capture a planning requirement or open question
#   fluencyloop principle --number §N …    capture a constitution principle
#   fluencyloop import                     import legacy session markdown into the store
#   fluencyloop review [--base <ref>]      assemble the PR view for the active feature
#   fluencyloop check [--json]             doctor: loop state + un-journaled drift
#   fluencyloop site [--port <port>]       serve the local 0.3 site (requires Node.js 18+)
#   fluencyloop slice-context [--json]     changed hunks + metadata for the current slice
#   fluencyloop calibration <init|show|edit|signal|compact>  your knowledge profile + its ledger
#   fluencyloop index                      regenerate docs/fluencyloop/README.md
#   fluencyloop rename-feature-dir --pr <n>  swap the active feature's dir to carry its PR number
#   fluencyloop migrate [--dry-run]        move docs from .fluencyloop/ to docs/fluencyloop/
#   fluencyloop version                    print the installed version
#   fluencyloop help

set -euo pipefail

# Resolve this script's real location, following symlinks. Portable: macOS `readlink` has no -f.
resolve_self() {
    local src="${BASH_SOURCE[0]}" dir
    while [ -h "$src" ]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ $src != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
SELF="$(resolve_self)"

# Version lives beside the bundled CLI.
VERSION_FILE="$SELF/VERSION"
read_version() { [ -f "$1" ] && cat "$1" || echo "unknown"; }

# Find the bundled scripts dir, or the current project's vendored copy after `fluencyloop init`.
if [ -d "$SELF/scripts/bash" ]; then
    BIN="$SELF/scripts/bash"          # running from the bundled plugin runtime
elif [ -d "$SELF/scripts" ] && [ -f "$SELF/scripts/common.sh" ]; then
    BIN="$SELF/scripts"               # running from an installed .fluencyloop/
else
    # Fall back to the current repo's vendored copy.
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    BIN="${ROOT:+$ROOT/.fluencyloop/scripts}"
fi

# Print the contiguous comment header (everything after the shebang, up to the first
# non-comment line) with the leading "# " stripped.
usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; }

# Node is deliberately optional: only the forthcoming local site server may execute it. Keep the
# rest of the loop runnable on an agent host with no Node installation at all.
require_node_for_site() {
    local node_bin node_version major
    node_bin="$(command -v node 2>/dev/null || true)"
    if [ -z "$node_bin" ]; then
        echo "Node.js 18 or newer is required only for 'fluencyloop site'." >&2
        echo "The rest of FluencyLoop works without Node.js. Install it from https://nodejs.org/ and rerun this command." >&2
        return 1
    fi
    node_version="$("$node_bin" --version 2>/dev/null || true)"
    major="${node_version#v}"; major="${major%%.*}"
    case "$major" in
        ''|*[!0-9]*)
            echo "Could not determine the installed Node.js version for 'fluencyloop site'." >&2
            echo "Node.js 18 or newer is required only for the local site. Install or update it at https://nodejs.org/." >&2
            return 1
            ;;
    esac
    if [ "$major" -lt 18 ]; then
        echo "Node.js $node_version is too old for 'fluencyloop site'; Node.js 18 or newer is required." >&2
        echo "The rest of FluencyLoop works without Node.js. Update it at https://nodejs.org/." >&2
        return 1
    fi
    NODE_BIN="$node_bin"
}

start_site() {
    require_node_for_site
    local project_root
    project_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -z "$project_root" ]; then
        echo "Error: 'fluencyloop site' must run inside a Git repository." >&2
        return 1
    fi
    exec "$NODE_BIN" "$SELF/site/server.js" --root "$project_root" "$@"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
    init)     exec bash "$BIN/init.sh" "$@" ;;
    plan)     exec bash "$BIN/new-plan.sh" "$@" ;;
    feature)  exec bash "$BIN/new-feature.sh" "$@" ;;
    session)  exec bash "$BIN/new-session.sh" "$@" ;;
    decision) exec bash "$BIN/add-decision.sh" "$@" ;;
    knowledge) exec bash "$BIN/add-knowledge.sh" "$@" ;;
    concept)  exec bash "$BIN/add-concept.sh" "$@" ;;
    requirement) exec bash "$BIN/add-requirement.sh" "$@" ;;
    principle) exec bash "$BIN/add-principle.sh" "$@" ;;
    import)   exec bash "$BIN/import-legacy.sh" "$@" ;;
    review)   exec bash "$BIN/assemble-pr-view.sh" "$@" ;;
    check)    exec bash "$BIN/check.sh" "$@" ;;
    site)     start_site "$@" ;;
    slice-context) exec bash "$BIN/slice-context.sh" "$@" ;;
    calibration) exec bash "$BIN/calibration.sh" "$@" ;;
    index)    exec bash "$BIN/index.sh" "$@" ;;
    rename-feature-dir) exec bash "$BIN/rename-feature-dir.sh" "$@" ;;
    migrate)  exec bash "$BIN/migrate.sh" "$@" ;;
    version|--version|-v) read_version "$VERSION_FILE" ;;
    help|-h|--help) usage ;;
    *) echo "Unknown command: $cmd" >&2; usage >&2; exit 1 ;;
esac
